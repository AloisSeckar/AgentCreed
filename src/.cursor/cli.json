{
    "permissions": {
        "allow": [
            "Shell(git:status)",
            "Shell(git:pull --ff-only)",
            "Shell(git:stash)",
            "Shell(git:stash pop)",
            "Shell(date:+%Y-%m-%dT%H:%M:%S%z)",
            "Shell(Get-Date:-Format o)"
        ],
        "deny": [
            "Shell(git:stash drop)",
            "Shell(git:stash clear)"
        ]
    }
}
