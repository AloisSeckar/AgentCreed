exports[`adds template metadata to an existing skill without frontmatter 1`] = `
"---
name: creed-dev
description: Template skill
---

<!-- ↓↓↓ agentcreed ↓↓↓ -->

Keep this instruction.

<!-- ↑↑↑ agentcreed ↑↑↑ -->

# Local skill

Keep this instruction.
"
`;

exports[`extracts first through last template markers without duplicating that span on reruns 1`] = `
