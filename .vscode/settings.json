{
    "files.associations": {
        "*.md": "markdown",
        "**/SKILL.md": "markdown",
        "LICENSE": "plaintext"
    },
    "chat.tools.terminal.autoApprove": {
        "git status": true,
        "git pull --ff-only": true,
        "git stash": true,
        "git stash pop": true,
        "git stash drop": false,
        "git stash clear": false,
        "date -u +%Y-%m-%dT%H:%M:%SZ": true,
        "Get-Date -Format o": true
    }
}
